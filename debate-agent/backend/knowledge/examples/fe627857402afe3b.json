  "core_claims": [
    {
      "text": "【论点1】在亲密关系中，爱的量化不仅能减少误会，还能帮助人们更好的经营感情，增强了人类个人层面的掌控。",
      "locator": "line:25"
    },
    {
      "text": "【论点2】在选择社会职能时，爱的量化能帮助人们筛选出候选者中潜在的危险人员，从源头上避免惨剧的发生，增强了人类社会层面的掌控。",
      "locator": "line:53"
    }
  ],
