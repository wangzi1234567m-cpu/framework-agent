  "core_claims": [
    {
      "text": "论点一、传统就业提供职业价值实现必需的稳定兜底与风险缓冲 ，而 OPC 模式下青年抗风险能力弱 ，变现困难 ，背离当代青年对于职业价值的追求",
      "locator": "word/document.xml:paragraph:29"
    },
    {
      "text": "论点二、传统就业模式能提供体系化的能力成长通道 ，而 OPC 模式缺乏能力培养的平台 ，限制当代青年的核心能力成长 ，难以实现后续职业发展",
      "locator": "word/document.xml:paragraph:62"
    }
  ],
